# Production build settings: copy to .env (git-ignored) and run `npm run generate`.
# Read by `nuxt generate` and by scripts/csp.mjs, so the CSP matches the features switched on here.
# Every variable is optional: empty = feature off.

# Laravel API endpoint for the contact form (empty = form opens the visitor's email app)
NUXT_PUBLIC_FORM_ENDPOINT=https://api.rafalgryncewicz.com/api/contact

# Cloudflare Turnstile site key (secret goes to api/.env as TURNSTILE_SECRET_KEY)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics: Google Tag Manager and/or GA4 (cookie banner applies), Plausible (cookieless)
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_GA_ID=
# advanced (default) = Google loads with storage denied; basic = no Google request before consent
NUXT_PUBLIC_CONSENT_MODE=advanced
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=

# CSP violation reports (default: <form endpoint origin>/api/csp-report). CSP_ENFORCE=1 to enforce.
# CSP_REPORT_URI=
# CSP_ENFORCE=1
